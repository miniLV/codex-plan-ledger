+describe('ms(string, { strict: true })', function() {
+  var invalidStrings = [
+    '☃',
+    '10-.5',
+    '1 fortnight',
+    '   ',
+    new Array(102).join('1')
+  ];
+
+  invalidStrings.forEach(function(value) {
+    it('should throw an Error containing the input for ' + JSON.stringify(value), function() {
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError(function(error) {
+        expect(error.constructor).to.be(Error);
+        expect(error.message.indexOf(value)).to.not.be(-1);
+      });
+    });
+
+    it('should return undefined without strict mode for ' + JSON.stringify(value), function() {
+      expect(ms(value)).to.be(undefined);
+      expect(ms(value, { strict: false })).to.be(undefined);
+    });
+  });
+
+  it('should preserve valid parsing results', function() {
+    ['0', '0ms', '-1h', '1.5h', '.5ms', '-.5h', '1.5H', '2 days'].forEach(
+      function(value) {
+        expect(ms(value, { strict: true })).to.be(ms(value));
+      }
+    );
+  });
+
+  it('should preserve the 100-character parsing limit', function() {
+    var value = '1' + new Array(98).join(' ') + 'ms';
+    expect(value.length).to.be(100);
+    expect(ms(value, { strict: true })).to.be(1);
+    expect(ms(value + ' ')).to.be(undefined);
+    expect(function() {
+      ms(value + ' ', { strict: true });
+    }).to.throwError(function(error) {
+      expect(error.message.indexOf(value + ' ')).to.not.be(-1);
+    });
+  });
+
+  it('should enable strict mode for truthy options', function() {
+    expect(function() {
+      ms('invalid', { strict: 1 });
+    }).to.throwError();
+  });
+
+  it('should preserve numeric formatting', function() {
+    expect(ms(60000, { strict: true })).to.be('1m');
+    expect(ms(60000, { strict: true, long: true })).to.be('1 minute');
+  });
+
+  it('should preserve existing invalid-input errors', function() {
+    ['', undefined, null, [], {}, NaN, Infinity, -Infinity].forEach(function(value) {
+      var existingMessage;
+      try {
+        ms(value);
+      } catch (error) {
+        existingMessage = error.message;
+      }
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError(function(error) {
+        expect(error.constructor).to.be(Error);
+        expect(error.message).to.be(existingMessage);
+      });
+    });
+  });
+});
