+describe('ms(string, { strict: true })', function() {
+  var invalidStrings = ['☃', '10-.5', '1 fortnight', '   '];
+
+  invalidStrings.forEach(function(value) {
+    it('should return undefined by default for ' + JSON.stringify(value), function() {
+      expect(ms(value)).to.be(undefined);
+      expect(ms(value, { strict: false })).to.be(undefined);
+    });
+
+    it('should throw for ' + JSON.stringify(value), function() {
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError(function(error) {
+        expect(error).to.be.an(Error);
+        expect(error.message).to.be(
+          'Cannot parse time string: ' + JSON.stringify(value)
+        );
+      });
+    });
+  });
+
+  it('should preserve valid parsing results', function() {
+    expect(ms('0', { strict: true })).to.be(0);
+    expect(ms('0ms', { strict: true })).to.be(0);
+    expect(ms('-1h', { strict: true })).to.be(-3600000);
+    expect(ms('1.5H', { strict: true })).to.be(5400000);
+    expect(ms('-.5 hr', { strict: true })).to.be(-1800000);
+    expect(ms('2 days', { strict: true })).to.be(172800000);
+  });
+
+  it('should enforce the existing string length limit', function() {
+    var atLimit = '1' + new Array(98).join(' ') + 'ms';
+    var overLimit = '1' + new Array(99).join(' ') + 'ms';
+
+    expect(atLimit.length).to.be(100);
+    expect(overLimit.length).to.be(101);
+    expect(ms(atLimit, { strict: true })).to.be(1);
+    expect(ms(overLimit)).to.be(undefined);
+    expect(ms(overLimit, { strict: false })).to.be(undefined);
+    expect(function() {
+      ms(overLimit, { strict: true });
+    }).to.throwError();
+  });
+
+  it('should enable strict parsing for truthy option values', function() {
+    expect(function() {
+      ms('invalid', { strict: 1 });
+    }).to.throwError();
+  });
+
+  it('should preserve numeric formatting', function() {
+    expect(ms(60000, { strict: true })).to.be('1m');
+    expect(ms(60000, { strict: true, long: true })).to.be('1 minute');
+  });
+
+  it('should preserve errors for invalid inputs', function() {
+    ['', undefined, null, [], {}, NaN, Infinity, -Infinity].forEach(function(value) {
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError();
+    });
+  });
+});
