+describe('ms(string, { strict: true })', function() {
+  var invalidStrings = ['☃', '10-.5', '1 fortnight', '   ', new Array(102).join('1')];
+
+  it('should throw a descriptive error for unparseable strings', function() {
+    invalidStrings.forEach(function(value) {
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError(function(error) {
+        expect(error).to.be.an(Error);
+        expect(error.message).to.be(
+          'Cannot parse time value. val=' + JSON.stringify(value)
+        );
+      });
+    });
+  });
+
+  it('should return undefined unless strict is exactly true', function() {
+    invalidStrings.forEach(function(value) {
+      expect(ms(value)).to.be(undefined);
+      [false, undefined, null, 0, 1, 'true', {}].forEach(function(strict) {
+        expect(ms(value, { strict: strict })).to.be(undefined);
+      });
+    });
+  });
+
+  it('should preserve valid parsing, including zero', function() {
+    expect(ms('0', { strict: true })).to.be(0);
+    expect(ms('0ms', { strict: true })).to.be(0);
+    expect(ms('-100ms', { strict: true })).to.be(-100);
+    expect(ms('-.5h', { strict: true })).to.be(-1800000);
+    expect(ms('1.5H', { strict: true })).to.be(5400000);
+    expect(ms('1   s', { strict: true })).to.be(1000);
+    expect(ms(new Array(101).join('0'), { strict: true })).to.be(0);
+  });
+
+  it('should preserve numeric formatting', function() {
+    expect(ms(60000, { strict: true })).to.be('1m');
+    expect(ms(60000, { strict: true, long: true })).to.be('1 minute');
+  });
+
+  it('should preserve existing invalid-input errors', function() {
+    ['', undefined, null, [], {}, NaN, Infinity, -Infinity].forEach(function(value) {
+      expect(function() {
+        ms(value, { strict: true });
+      }).to.throwError(function(error) {
+        expect(error.message).to.be(
+          'val is not a non-empty string or a valid number. val=' +
+            JSON.stringify(value)
+        );
+      });
+    });
+  });
+});
+
