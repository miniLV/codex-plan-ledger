{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miniLV/codex-plan-ledger/main/schema/decisions.schema.json",
  "title": "codex-plan-ledger decisions.json",
  "description": "Decisions taken from one Codex plan. schema_version 1.",
  "type": "object",
  "required": ["schema_version", "plan_id", "title", "source", "created_at", "updated_at", "revision", "plan_sha256", "decisions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "enum": ["codex-plan-mode", "manual"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": { "type": "string" },
    "scope": { "$ref": "#/$defs/affected" },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "earlier_answers": {
      "description": "Answers given in an earlier revision whose decision is not in this revision (or whose chosen option is gone). Kept so answers are never silently dropped.",
      "type": "array",
      "items": { "$ref": "#/$defs/earlierAnswer" }
    }
  },
  "$defs": {
    "affected": {
      "type": "object",
      "required": ["files", "modules"],
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]{1,12}$" },
        "label": { "type": "string" },
        "recommended": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "title", "options", "chosen", "status", "affected", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "question": { "type": "string" },
        "kind": { "enum": ["question", "options", "tbd", "decision", "assumption"] },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "default": { "type": ["string", "null"] },
        "chosen": { "type": ["string", "null"], "description": "Option id, \"other\", or null when there is no default and no answer." },
        "other": { "type": ["string", "null"], "maxLength": 2000 },
        "status": { "enum": ["answered", "default"], "description": "\"default\" means not answered; default kept. It is not agreement." },
        "affected": { "$ref": "#/$defs/affected" },
        "rationale": { "type": ["string", "null"], "maxLength": 2000 },
        "carried": {
          "description": "Present when this answer was given in an earlier revision and carried forward. Removed when the decision is answered again.",
          "type": "object",
          "required": ["from_revision", "match", "previous_id"],
          "additionalProperties": false,
          "properties": {
            "from_revision": { "type": "integer", "minimum": 1 },
            "match": { "enum": ["id", "title"] },
            "previous_id": { "type": "string" }
          }
        }
      }
    },
    "earlierAnswer": {
      "type": "object",
      "required": ["id", "title", "chosen", "from_revision", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "chosen": { "type": ["string", "null"] },
        "chosen_label": { "type": ["string", "null"] },
        "other": { "type": ["string", "null"], "maxLength": 2000 },
        "rationale": { "type": ["string", "null"], "maxLength": 2000 },
        "from_revision": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["decision not in this revision", "option no longer offered"] }
      }
    }
  }
}
